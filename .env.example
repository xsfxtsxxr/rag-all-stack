# ============================================================
# 应用共用环境文件：复制为 .env 使用
# 读取方：Next.js（apps/web）、AI 服务本地运行（services/ai）、
#         数据库脚本（packages/database）
# docker compose 不用本文件，它读取 docker-compose/.env（模板 docker-compose/.env.example）
# 端口与凭据必须和 docker-compose/.env 保持一致
# ============================================================

# ===== 基础设施连接（宿主机端口，与 docker-compose/.env 一致）=====
DATABASE_URL=postgres://rag_all_stack_db:rag_all_stack_db@localhost:55432/rag_all_stack_db
# AI 服务地址：本地直跑=8008（热更新，8000 常被其他项目占用）；compose --profile deploy 部署容器=58008
AI_SERVICE_URL=http://localhost:8008
# AI 服务本地直跑时的文档目录（部署容器内固定为 /data/inbox，无需此项）
DOCS_DIR=/path/to/rag-all-stack/data/inbox

# ===== NextAuth（生产环境务必更换为随机值）=====
NEXTAUTH_SECRET=dev-only-secret-change-me
NEXTAUTH_URL=http://localhost:3000

# ===== AI 服务：嵌入模型（中文场景默认 bge-small-zh；英文可切换 all-MiniLM-L6-v2）=====
# 本地直跑 services/ai 时读取本文件；docker 方式运行时改 docker-compose/.env
# 模型下载源（国内无法访问 huggingface.co 时用 hf-mirror.com 镜像）
HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# bge-small-zh-v1.5 = 512 维；all-MiniLM-L6-v2 = 384 维（切换模型时必须同步修改）
EMBED_DIM=512

# ===== LLM（OpenAI 兼容接口）。示例：Deepseek 端点= https://api.deepseek.com + deepseek-v4-flash；
# 留空则降级为直接返回检索资料 =====
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=XXXXXXXXXXXXXXXX
# 推理强度 low/high/max（deepseek-v4-flash 必开 thinking），留空则不发送
LLM_REASONING_EFFORT=low
