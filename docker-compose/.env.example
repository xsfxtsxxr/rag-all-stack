# ============================================================
# docker compose 专用环境文件：复制为 .env 使用（已 gitignore）
# compose 会自动加载与 docker-compose.yml 同目录的 .env，无需 --env-file：
#   docker compose -f docker-compose/docker-compose.yml up -d
# 注意：宿主机端口/凭据修改后，必须同步修改根目录 .env 中对应的连接串；
#      修改 POSTGRES_USER/PASSWORD/DB 后需重建数据卷（docker compose down -v）
# ============================================================

# ===== 镜像 =====
POSTGRES_IMAGE=pgvector/pgvector:pg16   # 必须含 pgvector 扩展（vector 字段依赖），勿换成普通 postgres

# ===== AI 镜像构建：PyPI 源（网络受限时切换，如 https://mirrors.aliyun.com/pypi/simple）=====
PYPI_INDEX_URL=https://pypi.org/simple

# ===== PostgreSQL（宿主机端口统一 5xxxx，避免与其他项目冲突）=====
POSTGRES_USER=rag_all_stack_db
POSTGRES_PASSWORD=rag_all_stack_db
POSTGRES_DB=rag_all_stack_db
POSTGRES_HOST_PORT=55432
POSTGRES_CONTAINER_PORT=5432

# ===== AI 服务 =====
AI_HOST_PORT=58008
# 嵌入模型下载源（国内无法访问 huggingface.co 时用 hf-mirror.com 镜像）
HF_ENDPOINT=https://hf-mirror.com
# 嵌入模型与 LLM（与根目录 .env 中同名字段保持一致）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=XXXXXXXXXXXXXXXX
# 推理强度 low/high/max（deepseek-v4-flash 必开 thinking），留空则不发送
LLM_REASONING_EFFORT=low

# ===== Next.js 前端 =====
WEB_HOST_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# 部署前请替换为随机密钥，例如：openssl rand -base64 32
NEXTAUTH_SECRET=replace-this-with-a-random-secret
